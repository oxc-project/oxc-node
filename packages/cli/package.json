{
  "name": "@oxc-node/cli",
  "version": "1.0.0",
  "description": "OXC Node cli",
  "homepage": "https://github.com/oxc-project/oxc-node/tree/main/packages/cli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxc-project/oxc-node.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Brooooooklyn"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Boshen"
    }
  ],
  "bin": {
    "oxnode": "./dist/index.js"
  },
  "files": [
    "dist",
    "watch.d.ts"
  ],
  "type": "module",
  "exports": {
    "./watch": {
      "types": "./watch.d.ts",
      "import": "./dist/watch.js",
      "default": "./dist/watch.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rolldown --config ./rolldown.config.js",
    "dev": "node --import @oxc-node/core/register ./src/index.ts"
  },
  "dependencies": {
    "@oxc-node/core": "workspace:*"
  },
  "devDependencies": {
    "clipanion": "^4.0.0-rc.4",
    "rolldown": "^1.2.12"
  }
}
